# ==========================================
# JobSpace — Backend Environment Variables
# ==========================================

# PostgreSQL connection with pgvector (Note: Docker exposes host port 5433)
DATABASE_URL=postgresql+psycopg2://jobspace:jobspace@localhost:5433/jobspace

# Ollama local inference & embedding server
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
OLLAMA_CHAT_MODEL=qwen3:14b

# JWT Authentication
SECRET_KEY=change-this-in-production-jobspace-secret-key-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440